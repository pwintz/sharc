\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces MPC waypoint-tracking formulation. The ego vehicle at position $(p_x, p_y)$ moves with speed $v_k$ and heading $\psi _k$ (measured from east, shown as an arc). Reference waypoints $\{w^{(i)}\}_{i=1}^{N_w}$ (\textcolor {steelblue}{blue}) define the desired path. At each step $k$, MPC rolls out the kinematic bicycle model~\eqref  {eq:bicycle} to obtain $N_p$ predicted states $\hat  {x}_{k+j|k}$ (\textcolor {mutedred}{red}) and minimizes the sum of squared distances $d_{j|k}$ (\textcolor {mutedpurple}{purple dashed}) from each predicted position to the closest waypoint~\eqref  {eq:closest_wp}.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:mpc_waypoints}{{1}{4}{MPC waypoint-tracking formulation. The ego vehicle at position $(p_x, p_y)$ moves with speed $v_k$ and heading $\psi _k$ (measured from east, shown as an arc). Reference waypoints $\{w^{(i)}\}_{i=1}^{N_w}$ (\textcolor {steelblue}{blue}) define the desired path. At each step $k$, MPC rolls out the kinematic bicycle model~\eqref {eq:bicycle} to obtain $N_p$ predicted states $\hat {x}_{k+j|k}$ (\textcolor {mutedred}{red}) and minimizes the sum of squared distances $d_{j|k}$ (\textcolor {mutedpurple}{purple dashed}) from each predicted position to the closest waypoint~\eqref {eq:closest_wp}}{figure.1}{}}
